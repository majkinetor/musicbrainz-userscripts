# Repo-root .gitignore for shared infrastructure under /dev/.
# Per-userscript ignores live in each userscript's own .gitignore
# (e.g. userscripts/discogs_credits/.gitignore).

# GitHub credentials for the dedicated automation account (claude-ai-milic).
# Never commit. Sample shape in userscripts/discogs_credits/DEVELOP.md.
dev/.github-credentials.json

# State + audit logs for the GH notification → channel pipeline. Each side
# (the poller and the MCP channel server) writes its own log so both halves
# are inspectable. Pure local runtime state.
dev/github-notifications/.notification-state.json
dev/github-notifications/.notif-poll.log
dev/notif-channel/.channel.log
dev/notif-channel/node_modules/

# Repo-root noise from running pnpm install at the root by accident
# (the real packages live under userscripts/*/).
/node_modules/
/package.json
/pnpm-lock.yaml

# Per-developer MCP config. Each contributor copies
# `dev/notif-channel/mcp.json.template` → `.mcp.json` themselves
# (see DEVELOP.md). The template is tracked; the live config isn't.
/.mcp.json

# Claude Code per-user state: permission allowlist, etc. Machine-specific.
/.claude/

# Shared Playwright profile (logged-in MB session + IDB cache) reused by every
# userscript test harness. Populate once with `node test/login.mjs` from any
# harness. Never commit — it holds session cookies.
/.pw-profile/
userscripts/falcon/test/_535-aliases.json
userscripts/credit_hoarder/_rp.mjs
userscripts/*/test/*.png
userscripts/*/test/logs/

# Working screenshots taken while iterating on an issue. Throwaway by
# definition — the ones that are meant to last live in dev/screens/, which is
# regenerated by `node dev/shoot-ui.mjs` and IS tracked.
dev/_*.png
dev/i2*.png

# dev/script-metrics is a standalone tool with its own `npm install`; its
# node_modules and run log were tracked by accident (175 files, 18 MB).
dev/script-metrics/node_modules/
dev/script-metrics/_backfill.log

# Repo-root scratch that keeps reappearing: one-off probe scripts, stray
# Playwright profiles from a mistyped path, and an accidental root build.
/probe-*.mjs
/dist/
/*.pw-profile/
/.pw-profile-ff/
