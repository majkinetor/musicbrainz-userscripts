#!/bin/sh
# Pre-commit: refuse a staged userscript that doesn't parse or lint clean, then
# rebuild dist/ and the bundles for any userscript whose source is being committed.
#
# Why: dist/<userscript>.user.js is the install vector (the README links the
# raw GitHub URL of the latest release), so the committed dist/ has to match
# the committed src/. Without this hook, "I forgot to rebuild" silently ships
# a stale userscript.
#
# Activation: `pnpm install` at the repo root runs the `prepare` script in the
# root package.json (dev/install-hook.mjs), which sets `core.hooksPath` to
# .githooks/ for the local clone. New contributors get the hook automatically
# the first time they install dependencies.
#
# Bypass: `git commit --no-verify`. Use sparingly (e.g. doc-only commits
# where you're sure src/ didn't change).

set -e

STAGED=$(git diff --cached --name-only)

# lint + syntax gate (#623) — a staged monolithic userscript must parse and lint
# clean (errors only; warnings are for a later look). Runs before any rebuild, so a
# broken script never reaches the bundle. The bundle and the frozen discogs_credits
# are not linted; Credit Hoarder's src/ has its own gate, right after.
USER_JS=$(printf '%s\n' "$STAGED" | grep -E '^userscripts/.+\.user\.js$' | grep -vE '^userscripts/(string_theory|discogs_credits)/|/dist/' || true)
if [ -n "$USER_JS" ]; then
    PRESENT=""
    for f in $USER_JS; do
        [ -f "$f" ] || continue
        node --check "$f" || { echo "[pre-commit] $f does not parse — nothing committed"; exit 1; }
        PRESENT="$PRESENT $f"
    done
    if [ -n "$PRESENT" ] && [ -f node_modules/eslint/bin/eslint.js ]; then
        node node_modules/eslint/bin/eslint.js --quiet $PRESENT || { echo "[pre-commit] lint errors above — nothing committed"; exit 1; }
    elif [ -n "$PRESENT" ]; then
        echo "[pre-commit] eslint is not installed at the repo root (pnpm install) — lint skipped"
    fi
fi
if printf '%s\n' "$STAGED" | grep -qE '^userscripts/credit_hoarder/src/'; then
    (cd userscripts/credit_hoarder && pnpm run lint >/dev/null) || { echo "[pre-commit] Credit Hoarder lint errors (pnpm --dir userscripts/credit_hoarder run lint) — nothing committed"; exit 1; }
fi

# platform icons (#404) — when the shared icon set changes, re-inline it into every
# script carrying a `// <ST-ICONS>` marker and re-stage them. Runs FIRST so the bundle
# rebuild below sees any synced members (STAGED is refreshed afterwards).
if printf '%s\n' "$STAGED" | grep -qE '^dev/ui/platform-icons\.mjs$'; then
    echo "[pre-commit] syncing shared platform icons…"
    node dev/ui/sync-icons.mjs >/dev/null
    ICON_FILES=$(grep -rl '// <ST-ICONS>' userscripts --include='*.js' 2>/dev/null || true)
    [ -n "$ICON_FILES" ] && git add $ICON_FILES
    STAGED=$(git diff --cached --name-only)
fi

# design tokens (#562) — same deal: the shared token set is the single place the
# look is configured, so when it changes, re-inline it into every script carrying
# a `// <ST-TOKENS>` marker. Also FIRST, for the same reason as the icons above.
if printf '%s\n' "$STAGED" | grep -qE '^dev/tokens/(design-tokens|sync-tokens)\.mjs$'; then
    echo "[pre-commit] syncing shared design tokens…"
    node dev/tokens/sync-tokens.mjs >/dev/null
    TOKEN_FILES=$(grep -rl '// <ST-TOKENS>' userscripts --include='*.js' 2>/dev/null || true)
    [ -n "$TOKEN_FILES" ] && git add $TOKEN_FILES
    STAGED=$(git diff --cached --name-only)
fi

# UI components (#563) — the shared widgets. Same deal as the tokens above.
if printf '%s
' "$STAGED" | grep -qE '^dev/ui/(ui-components|sync-ui)\.mjs$'; then
    echo "[pre-commit] syncing shared UI components…"
    node dev/ui/sync-ui.mjs >/dev/null
    UI_FILES=$(grep -rl '// <ST-UI>' userscripts --include='*.js' 2>/dev/null || true)
    [ -n "$UI_FILES" ] && git add $UI_FILES
    STAGED=$(git diff --cached --name-only)
fi

# shared matching (#613) — dev/match/artist-match.mjs is the one source for the exact-
# identity rule Apollo, Group Therapy and Credit Hoarder use. Re-inline it into every
# script carrying a `// <ST-MATCH>` marker (Credit Hoarder imports it via esbuild — its
# rebuild below watches dev/match too).
if printf '%s\n' "$STAGED" | grep -qE '^dev/match/(artist-match|sync-match)\.mjs$'; then
    echo "[pre-commit] syncing shared matching…"
    node dev/match/sync-match.mjs >/dev/null
    MATCH_FILES=$(grep -rl '// <ST-MATCH>' userscripts --include='*.js' 2>/dev/null || true)
    [ -n "$MATCH_FILES" ] && git add $MATCH_FILES
    STAGED=$(git diff --cached --name-only)
fi

# shared MusicBrainz request gate (#633) — dev/net/mb-gate.mjs, re-inlined into every
# script carrying a `// <ST-NET>` marker (Credit Hoarder imports it via esbuild — its
# rebuild below watches dev/net too).
if printf '%s\n' "$STAGED" | grep -qE '^dev/net/(mb-gate|sync-gate)\.mjs$'; then
    echo "[pre-commit] syncing the shared request gate…"
    node dev/net/sync-gate.mjs >/dev/null
    NET_FILES=$(grep -rl '// <ST-NET>' userscripts --include='*.js' 2>/dev/null || true)
    [ -n "$NET_FILES" ] && git add $NET_FILES
    STAGED=$(git diff --cached --name-only)
fi

# shared image maximizer (#717) — dev/imgmax/image-maximizer.js, re-inlined into every
# script carrying a `// <ST-IMGMAX>` marker.
if printf '%s
' "$STAGED" | grep -qE '^dev/imgmax/(image-maximizer\.js|sync-imgmax\.mjs)$'; then
    echo "[pre-commit] syncing the shared image maximizer…"
    node dev/imgmax/sync-imgmax.mjs >/dev/null
    IMGMAX_FILES=$(grep -rl '// <ST-IMGMAX>' userscripts --include='*.js' 2>/dev/null || true)
    [ -n "$IMGMAX_FILES" ] && git add $IMGMAX_FILES
    STAGED=$(git diff --cached --name-only)
fi

# shared guess case (#785) — dev/guesscase/guess-case.mjs, re-inlined into every script
# carrying a `// <ST-GUESSCASE>` marker.
if printf '%s\n' "$STAGED" | grep -qE '^dev/guesscase/(guess-case|sync-guesscase)\.mjs$'; then
    echo "[pre-commit] syncing the shared guess case…"
    node dev/guesscase/sync-guesscase.mjs >/dev/null
    GUESSCASE_FILES=$(grep -rl '// <ST-GUESSCASE>' userscripts --include='*.js' 2>/dev/null || true)
    [ -n "$GUESSCASE_FILES" ] && git add $GUESSCASE_FILES
    STAGED=$(git diff --cached --name-only)
fi

# shared MusicBrainz page helpers (#722, #723) — dev/mbpage/mb-page.mjs, re-inlined into every
# script carrying a `// <ST-MBPAGE>` marker (Credit Hoarder imports it via esbuild — its
# rebuild below watches dev/mbpage too).
if printf '%s\n' "$STAGED" | grep -qE '^dev/mbpage/(mb-page|sync-mbpage)\.mjs$'; then
    echo "[pre-commit] syncing the shared MusicBrainz page helpers…"
    node dev/mbpage/sync-mbpage.mjs >/dev/null
    MBPAGE_FILES=$(grep -rl '// <ST-MBPAGE>' userscripts --include='*.js' 2>/dev/null || true)
    [ -n "$MBPAGE_FILES" ] && git add $MBPAGE_FILES
    STAGED=$(git diff --cached --name-only)
fi

# shared Wayback Machine helpers (#736) — dev/archive/wayback.mjs, re-inlined into every
# script carrying a `// <ST-ARCHIVE>` marker.
if printf '%s\n' "$STAGED" | grep -qE '^dev/archive/(wayback|sync-archive)\.mjs$'; then
    echo "[pre-commit] syncing the shared Wayback Machine helpers…"
    node dev/archive/sync-archive.mjs >/dev/null
    ARCHIVE_FILES=$(grep -rl '// <ST-ARCHIVE>' userscripts --include='*.js' 2>/dev/null || true)
    [ -n "$ARCHIVE_FILES" ] && git add $ARCHIVE_FILES
    STAGED=$(git diff --cached --name-only)
fi

# (discogs_credits is frozen — no longer developed — so its bundle is not rebuilt here.)

# credit_hoarder — esbuild bundle. It was
# missing here, so a shared-component sync (which rewrites src/ui-bar.js) left
# the committed dist/ — the file people actually install — one build behind.
if printf '%s\n' "$STAGED" | grep -qE '^(userscripts/credit_hoarder/(src/|build\.mjs)|dev/match/artist-match\.mjs$|dev/net/mb-gate\.mjs$|dev/mbpage/mb-page\.mjs$)'; then
    echo "[pre-commit] rebuilding userscripts/credit_hoarder/dist/…"
    (cd userscripts/credit_hoarder && pnpm run build >/dev/null)
    git add userscripts/credit_hoarder/dist/credit_hoarder.user.js
    # refresh, or the String Theory step below never sees the rebuilt dist when only
    # src/ was staged — the bundle then shipped the previous Credit Hoarder (#613)
    STAGED=$(git diff --cached --name-only)
fi

# string_theory — unified bundle. Rebuild when any listed constituent's userscript
# changes, or when the bundler / icon / members list itself changes. A member's
# README.md change also triggers it — build.mjs regenerates the unified DOCS.md
# (#403). The member list is read from members.txt so there's a single source of truth.
ST_MEMBERS=$(sed 's/#.*//' userscripts/string_theory/members.txt 2>/dev/null | tr -d '[:blank:]' | grep -v '^$' | paste -sd '|' -)
if [ -n "$ST_MEMBERS" ] && { printf '%s\n' "$STAGED" | grep -qE "^userscripts/($ST_MEMBERS)/.+\.user\.js$" \
   || printf '%s\n' "$STAGED" | grep -qE "^userscripts/($ST_MEMBERS)/README\.md$" \
   || printf '%s\n' "$STAGED" | grep -qE '^userscripts/string_theory/(build\.mjs|match\.mjs|icon\.svg|members\.txt)$'; }; then
    echo "[pre-commit] rebuilding userscripts/string_theory/…"
    node userscripts/string_theory/build.mjs >/dev/null
    git add userscripts/string_theory/string_theory.user.js userscripts/string_theory/DOCS.md
fi

