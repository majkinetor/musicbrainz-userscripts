# Repo-root .gitignore for shared infrastructure under /dev/.
# Per-userscript ignores live in each userscript's own .gitignore
# (e.g. userscripts/discogs_credits/.gitignore).

# The bot token lives in the hub (DEVELOP.md#bot-identity); this only guards a stray copy.
dev/.github-credentials.json

# Repo-level tooling (the shared test runner, #625) installs here; the
# per-script build packages still live under userscripts/*/.
/node_modules/
# `pnpm test` output: the HTML report and failure screenshots.
/test-results/

# Per-developer MCP config.
/.mcp.json

# Claude Code per-user state: permission allowlist, etc. Machine-specific.
# Project skills and the shared settings (the cloud session-start hook) are tracked.
/.claude/*
!/.claude/skills/
!/.claude/settings.json
!/.claude/hooks/

# Shared Playwright profile (logged-in MB session + IDB cache) reused by every
# userscript test. Populate once with `node dev/test/login.mjs` (production and
# sandbox). Never commit — it holds session cookies.
/.pw-profile/
userscripts/credit_hoarder/_rp.mjs

# Working screenshots taken while iterating on an issue. Throwaway by
# definition — the ones that are meant to last live in dev/screens/, which is
# regenerated by `node dev/shoot-ui.mjs` and IS tracked.
dev/_*.png
dev/i2*.png

# dev/script-metrics is a standalone tool with its own `npm install`; its
# node_modules and run log were tracked by accident (175 files, 18 MB).
dev/script-metrics/node_modules/
dev/script-metrics/_backfill.log

# Scratch that keeps reappearing: one-off probe scripts, stray Playwright
# profiles from a mistyped path, and an accidental root build. The profile
# pattern matches at any depth: bash stripping the backslashes from
# C:\Work\mb-userscripts\.pw-profile makes Node read it as a relative path,
# which creates the profile in whatever script folder the harness ran from.
/probe-*.mjs
/dist/
*.pw-profile/
/.pw-profile-ff/
/.pw-profile-recheck/
