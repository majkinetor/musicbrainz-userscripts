{
  "name": "mb-userscripts",
  "private": true,
  "description": "Repo-level tooling: the shared test runner (#625), the lint gate (#623), the pre-commit hook.",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "prepare": "node dev/install-hook.mjs",
    "lint": "eslint \"userscripts/*/*.user.js\" \"userscripts/art_station/as_picker/*.user.js\"",
    "test": "playwright test",
    "test:unit": "playwright test --grep @unit",
    "test:core": "playwright test --grep-invert @cosmetic",
    "test:flaky": "playwright test --grep @flaky --repeat-each 10",
    "test:report": "playwright show-report test-results/html"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "eslint": "^10.4.0",
    "globals": "^16.5.0"
  }
}
