#!/bin/sh
# Pre-commit: rebuild dist/ for any userscript whose source is being committed.
#
# Why: dist/<userscript>.user.js is the install vector (the README links the
# raw GitHub URL of the latest release), so the committed dist/ has to match
# the committed src/. Without this hook, "I forgot to rebuild" silently ships
# a stale userscript.
#
# Activation: `pnpm install` at the repo root runs the `prepare` script in
# package.json, which sets `core.hooksPath` to .githooks/ for the local
# clone. New contributors get the hook automatically the first time they
# install dependencies.
#
# Bypass: `git commit --no-verify`. Use sparingly (e.g. doc-only commits
# where you're sure src/ didn't change).

set -e

STAGED=$(git diff --cached --name-only)

# discogs_credits — esbuild bundle
if printf '%s\n' "$STAGED" | grep -qE '^userscripts/discogs_credits/(src/|build\.mjs)'; then
    echo "[pre-commit] rebuilding userscripts/discogs_credits/dist/…"
    (cd userscripts/discogs_credits && pnpm run build >/dev/null)
    git add userscripts/discogs_credits/dist/discogs_credits.user.js
fi

# string_theory — unified bundle. Rebuild when any listed constituent's userscript
# changes, or when the bundler / icon / members list itself changes. The member list
# is read from members.txt so there's a single source of truth.
ST_MEMBERS=$(sed 's/#.*//' userscripts/string_theory/members.txt 2>/dev/null | tr -d '[:blank:]' | grep -v '^$' | paste -sd '|' -)
if [ -n "$ST_MEMBERS" ] && { printf '%s\n' "$STAGED" | grep -qE "^userscripts/($ST_MEMBERS)/.+\.user\.js$" \
   || printf '%s\n' "$STAGED" | grep -qE '^userscripts/string_theory/(build\.mjs|icon\.svg|members\.txt)$'; }; then
    echo "[pre-commit] rebuilding userscripts/string_theory/…"
    node userscripts/string_theory/build.mjs >/dev/null
    git add userscripts/string_theory/string_theory.user.js
fi

